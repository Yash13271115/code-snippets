{
  "File": "html.json",

  "HTML Boilerplate": {
    "prefix": "html-boilerplate",
    "body": [
      "<!DOCTYPE html>",
      "<html lang=\"en\">",
      "<head>",
      "    <meta charset=\"UTF-8\">",
      "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
      "    <title>${1:Document}</title>",
      "</head>",
      "<body>",
      "    ${2:<!-- Your content here -->}",
      "</body>",
      "</html>"
    ],
    "description": "Basic HTML5 boilerplate"
  },
  "Font Awesome CDN": {
    "prefix": "font-awesome-cdn",
    "body": [
      "<script src=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/js/all.min.js\"></script>"
    ],
    "description": "Font Awesome v6.5.2"
  }
}
