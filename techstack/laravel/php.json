{
    "File": "php.json",
    "Laravel Middleware Append": {
        "prefix": "laravel-middleware-append",
        "body": [
            "\\$middleware->web(append: [",
            "    ${1:YourMiddleware}::class,",
            "]);"
        ],
        "description": "Append custom middleware to the web group in bootstrap/app.php"
    },
    "Laravel Middleware Append Inertia": {
        "prefix": "laravel-middleware-append-inertia",
        "body": [
            "// use App\\Http\\Middleware\\HandleInertiaRequests;",
            "\\$middleware->web(append: [",
            "    HandleInertiaRequests::class,",
            "]);"
        ],
        "description": "Append Inertia middleware to the web group in bootstrap/app.php"
    },
    "Laravel Basic Form Request": {
        "prefix": "laravel-request",
        "body": [
            "<?php",
            "",
            "namespace App\\Http\\Requests\\${1:Admin};",
            "",
            "use Illuminate\\Foundation\\Http\\FormRequest;",
            "",
            "class ${2:SampleRequest} extends FormRequest",
            "{",
            "    /**",
            "     * Determine if the user is authorized to make this request.",
            "     */",
            "    public function authorize(): bool",
            "    {",
            "        return true;",
            "    }",
            "",
            "    /**",
            "     * Get the validation rules that apply to the request.",
            "     */",
            "    public function rules(): array",
            "    {",
            "        $rules = [",
            "            '${3:field_name}' => '${4:required|string|max:255}',",
            "        ];",
            "",
            "        if (request()->isMethod('put')) {",
            "            $rules['${3:field_name}'] = '${5:required|string|max:255|unique:table,column}.' . request()->route('${6:id}');",
            "        }",
            "",
            "        return $rules;",
            "    }",
            "",
            "    /**",
            "     * Custom messages for validator errors.",
            "     */",
            "    public function messages()",
            "    {",
            "        return [",
            "            '${3:field_name}.required' => '${3:field_name} is required',",
            "            '${3:field_name}.max' => '${3:field_name} must not exceed ${7:255} characters',",
            "            '${3:field_name}.unique' => '${3:field_name} already exists',",
            "        ];",
            "    }",
            "}",
            ""
        ],
        "description": "Generate a basic Laravel FormRequest class"
    }
}