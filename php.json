{
    "Laravel Middleware Append": {
        "prefix": "laravel-middleware-append",
        "body": [
            "\\$middleware->web(append: [",
            "    ${1:YourMiddleware}::class,",
            "]);"
        ],
        "description": "Append custom middleware to the web group in bootstrap/app.php"
    },
    "Laravel Middleware Append Inertia": {
        "prefix": "laravel-middleware-append-inertia",
        "body": [
            "// use App\\Http\\Middleware\\HandleInertiaRequests;",
            "\\$middleware->web(append: [",
            "    HandleInertiaRequests::class,",
            "]);"
        ],
        "description": "Append Inertia middleware to the web group in bootstrap/app.php"
    },
    "Laravel Basic Form Request": {
        "prefix": "laravel-request",
        "body": [
            "<?php",
            "",
            "use Illuminate\\\\Foundation\\\\Http\\\\FormRequest;",
            "",
            "class ${1:SampleRequest} extends FormRequest",
            "{",
            "    public function authorize(): bool",
            "    {",
            "        return true;",
            "    }",
            "",
            "    public function rules(): array",
            "    {",
            "        \\$rules = [",
            "            '${2:field_name}' => '${3:required|string|max:255}',",
            "        ];",
            "",
            "        if (request()->isMethod('put')) {",
            "            \\$rules['${2:field_name}'] = '${4:required|string|max:255|unique:table,column,}' . request()->route('${5:id}');",
            "        }",
            "",
            "        return \\$rules;",
            "    }",
            "",
            "    public function messages()",
            "    {",
            "        return [",
            "            '${2:field_name}.required' => '${2:field_name} is required',",
            "            '${2:field_name}.max' => '${2:field_name} must not exceed ${6:255} characters',",
            "            '${2:field_name}.unique' => '${2:field_name} already exists',",
            "        ];",
            "    }",
            "}",
            ""
        ],
        "description": "Generate a basic Laravel FormRequest class (no namespace)"
    },
    "Laravel Inertia Route Shorthand": {
        "prefix": "laravel-inertia-route-shorthand",
        "body": [
            "Route::inertia('/$1', '$2');"
        ],
        "description": "Shorthand snippet for creating an Inertia route"
    }
}